# Copy to .env for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables instead.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/globelink_db?retryWrites=true&w=majority

# Long random strings (32+ characters), different for each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-for-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local HTTP: false/lax. Production with the website on a different domain from the
# API (e.g. *.lovable.app and *.vercel.app): COOKIE_SECURE=true and COOKIE_SAME_SITE=none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set true behind a proxy so rate limits see real client IPs (automatic on Vercel).
# TRUST_PROXY=true

# Comma-separated list of website origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Only used by `npm run seed`, never by the running API.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<choose-a-strong-password-of-12-or-more-characters>
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
# SEED_DEMO_COUNSELLOR_PASSWORD=<local-only-password>
# SEED_DEMO_VISA_OFFICER_PASSWORD=<local-only-password>
